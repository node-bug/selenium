{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run demo.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/demo.js",
      "console": "integratedTerminal"
    },
    {
      "name": "Run frame-element-access.test.js",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vitest",
        "run",
        "${workspaceFolder}/tests/integration/frame-element-access.test.js"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Run Basic Shadow DOM - Open Shadow Roots",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vitest",
        "run",
        "${workspaceFolder}/tests/integration/dropdown.test.js",
        "-t",
        "should start with subcategory disabled"
      ],
      "console": "integratedTerminal"
    }
  ]
}
